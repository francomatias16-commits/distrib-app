{
  "name": "distrib-app",
  "version": "1.49.9",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "retry-request": "^9.0.1",
    "teeny-request": "^11.0.1",
    "uuid": "^14.0.2"
  },
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.5.1",
    "express": "^4.19.2",
    "firebase-admin": "^14.2.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.4.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "playwright-core": "^1.56.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "check-schema": "node --experimental-vm-modules scripts/check-schema.js",
    "check-schema:hints": "node --experimental-vm-modules scripts/check-schema.js --fix-hints",
    "check-schema:json": "node --experimental-vm-modules scripts/check-schema.js --json",
    "check:migrations": "node scripts/check-migraciones-registro.js",
    "check-migrations:drift": "node scripts/check-migraciones-registro.js",
    "test:integration": "node scripts/test-integration.js",
    "test:integration:verbose": "node scripts/test-integration.js --verbose",
    "test:integration:no-cleanup": "node scripts/test-integration.js --no-cleanup",
    "test:integration:json": "node scripts/test-integration.js --json",
    "predeploy": "node scripts/check-migraciones-registro.js && node scripts/smoke-test-frontend.js && node scripts/check-asset-wiring.js && node scripts/check-api-wiring.js && node scripts/check-handler-dispatch.js",
    "check-asset-wiring": "node scripts/check-asset-wiring.js",
    "check-asset-wiring:json": "node scripts/check-asset-wiring.js --json",
    "check-api-wiring": "node scripts/check-api-wiring.js",
    "check-api-wiring:json": "node scripts/check-api-wiring.js --json",
    "check-handler-dispatch": "node scripts/check-handler-dispatch.js",
    "check-handler-dispatch:json": "node scripts/check-handler-dispatch.js --json",
    "check-wiring:all": "node scripts/check-asset-wiring.js && node scripts/check-api-wiring.js && node scripts/check-handler-dispatch.js",
    "cargar-embeddings-asistente": "node scripts/generar-embeddings-asistente.js",
    "cargar-embeddings-tools": "node scripts/generar-embeddings-tools.js",
    "eval:asistente": "node scripts/eval-asistente.js",
    "eval:asistente:json": "node scripts/eval-asistente.js --json",
    "build": "node scripts/bump-sw-version.js && node scripts/bump-asset-versions.js && esbuild frontend/**/*.js --minify --outdir=dist --outbase=frontend",
    "bump-asset-versions": "node scripts/bump-asset-versions.js",
    "bump-asset-versions:dry-run": "node scripts/bump-asset-versions.js --dry-run",
    "audit:security": "node scripts/audit-security-grants.js",
    "audit:security:json": "node scripts/audit-security-grants.js --json",
    "audit:funciones-fantasma": "node scripts/audit-funciones-fantasma.js",
    "audit:funciones-fantasma:json": "node scripts/audit-funciones-fantasma.js --json",
    "audit:resumenes-asistente": "node scripts/audit-resumenes-asistente.js",
    "audit:resumenes-asistente:json": "node scripts/audit-resumenes-asistente.js --json",
    "detectar:fallas-asistente": "node scripts/detectar-fallas-asistente.js",
    "detectar:fallas-asistente:json": "node scripts/detectar-fallas-asistente.js --json",
    "audit:all": "node scripts/audit-security-grants.js && node scripts/audit-funciones-fantasma.js && node scripts/audit-resumenes-asistente.js",
    "conciliar:cta-cte": "node scripts/conciliar-cta-cte.js",
    "conciliar:cta-cte:json": "node scripts/conciliar-cta-cte.js --json",
    "conciliar:stock": "node scripts/conciliar-stock.js",
    "conciliar:stock:json": "node scripts/conciliar-stock.js --json",
    "conciliar:all": "node scripts/conciliar-cta-cte.js && node scripts/conciliar-stock.js",
    "audit:mobile": "node scripts/audit-mobile.js",
    "audit:mobile:json": "node scripts/audit-mobile.js --json",
    "audit:breakpoints": "node scripts/audit-breakpoints.js",
    "audit:breakpoints:json": "node scripts/audit-breakpoints.js --json",
    "audit:a11y": "node scripts/audit-accesibilidad.js",
    "audit:a11y:json": "node scripts/audit-accesibilidad.js --json",
    "audit:lighthouse": "node scripts/audit-lighthouse.js",
    "audit:lighthouse:json": "node scripts/audit-lighthouse.js --json",
    "check:shared-selectors": "node scripts/check-shared-selectors.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c playwright.config.e2e.js",
    "test:e2e:ui": "playwright test -c playwright.config.e2e.js --ui",
    "loadtest": "node scripts/load-test.js",
    "loadtest:etapa4": "node scripts/load-test-etapa4.js",
    "audit:dinero": "node scripts/audit-dinero.js",
    "audit:dinero:json": "node scripts/audit-dinero.js --json"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "autocannon": "^7.15.0",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.4.1",
    "playwright": "^1.56.1",
    "vitest": "^4.1.10"
  }
}
