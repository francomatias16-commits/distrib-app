+// Igual que geminiKeysAgotadas, pero con cooldown temporal en vez de
+// bloqueo permanente: el 429 de Groq mezcla límites por minuto (RPM, que
+// resetea solo) y por día (RPD) sin distinguirlos de forma confiable en
+// el body del error (a diferencia de Gemini). Bloquear una key para
+// siempre ante CUALQUIER 429 arriesgaría dejarla afuera el resto del
+// proceso cálido por un límite de RPM que ya recuperó a los 60s. En vez
+// de eso, se guarda cuándo fue el último 429 de cada key y se la salta
+// solo mientras dure ese cooldown.
+const groqKeysEnCooldownHasta = new Map();
+const GROQ_COOLDOWN_MS = 60_000;
+
+async function llamarGroq(params) {
+  const { apiKeys } = CONFIG.groq;
+  if (!apiKeys.length) throw new Error('GROQ_API_KEY / GROQ_API_KEYS no configurada(s)');
+
+  const ahora = Date.now();
+  const keysDisponibles = apiKeys.filter((k) => (groqKeysEnCooldownHasta.get(k) || 0) <= ahora);
+  // Si TODAS están en cooldown (caso límite: muchas keys chocando en el
+  // mismo minuto), se prueban igual en vez de fallar directo — es mejor
+  // un intento con chance de 429 que rendirse sin pedir nada.
+  const keysAProbar = keysDisponibles.length ? keysDisponibles : apiKeys;
+
+  let ultimoError;
+  for (let i = 0; i < keysAProbar.length; i++) {
+    const apiKey = keysAProbar[i];
+    try {
+      const resultado = await llamarGroqConKey({ ...params, apiKey });
+      if (i > 0) {
+        console.log(`[asistente] Groq: respondió OK con la key #${i + 1} (key ${etiquetaKey(apiKey)}) tras rotar por límite en keys anteriores.`);
+      }
+      return resultado;
+    } catch (error) {
+      ultimoError = error;
+      if (error.status === 429) {
+        groqKeysEnCooldownHasta.set(apiKey, Date.now() + GROQ_COOLDOWN_MS);
+        console.warn(`[asistente] Groq (key ${etiquetaKey(apiKey)}): 429 (límite de tasa o cuota), rotando a la siguiente key.`);
+        continue;
+      }
+      // Error ajeno a rate-limit (400/401/5xx puntual, timeout): rotar de
+      // key no lo va a arreglar en la mayoría de los casos, pero como ya
+      // tenemos varias keys a mano y el costo de probar una más es bajo,
+      // seguimos igual — el corte real de la cadena lo hace el circuit
+      // breaker/timeout de más arriba, no este loop.
+    }
+  }
+
+  throw ultimoError || new Error('Groq: todas las keys fallaron.');
+}
